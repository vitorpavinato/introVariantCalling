# macOS
.DS_Store

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Dados de entrada pesados (usados apenas na preparação) ---
# Reads FASTQ (~330 MB): só servem para o bwa mem da preparação
data/trimmed_fastq_small/*.fastq

# Índices da referência: gerados por bwa index / samtools faidx
data/ref_genome/*.amb
data/ref_genome/*.ann
data/ref_genome/*.bwt
data/ref_genome/*.pac
data/ref_genome/*.sa

# O índice .fai é versionado: o IGV-Web exige FASTA + .fai para carregar a
# referência como genoma customizado. São 29 bytes.
!data/ref_genome/ecoli_rel606.fasta.fai

# Anotações da referência: não usadas nesta aula
data/ref_genome/*.gbff
data/ref_genome/*.gff

# --- Saídas geradas pelos alunos durante a aula ---
# Ignoramos o CONTEÚDO de results/, não a pasta em si: o git não desce em
# diretórios ignorados, e precisamos abrir uma exceção lá dentro.
results/*

# EXCEÇÃO: os 3 BAMs ordenados são o ponto de partida da aula e precisam ser
# versionados (resultado das etapas que pulamos — ver Seção 0). O .bai de cada
# um NÃO é versionado: os alunos o geram (Seção 2 / laço da Seção 7).
!results/bam/
results/bam/*
!results/bam/SRR2584863.aligned.sorted.bam
!results/bam/SRR2584866.aligned.sorted.bam
!results/bam/SRR2589044.aligned.sorted.bam

# EXCEÇÃO: o VCF final (110 KB) é versionado para poder ser carregado por URL
# no IGV-Web (Seção 6), sem que o aluno precise baixar nada do Binder.
!results/vcf/
results/vcf/*
!results/vcf/SRR2584866_final_variants.vcf
